# lista modelos
curl https://tseiiti.duckdns.org:11434/api/tags -H "Accept: application/json"

# lista modelos em execução
curl https://tseiiti.duckdns.org:11434/api/ps -H "Accept: application/json"

# ativa um modelo
curl -X POST https://tseiiti.duckdns.org:11434/api/chat -H "Content-Type: application/json" -d "{ \"model\": \"gemma3:1b\", \"prompt\": \"\" }"

# desativa um modelo
curl -X POST https://tseiiti.duckdns.org:11434/api/generate -H "Content-Type: application/json" -d "{ \"model\": \"gemma3:1b\", \"keep_alive\": 0 }"

curl -X POST https://tseiiti.duckdns.org:11434/api/chat -H "Content-Type: application/json" -d "{ \"model\": \"gemma3:1b\", \"prompt\": \"o que é o cálculo O.E.E?\" }"

###

GET  http://localhost:11434/api/tags

###

POST http://localhost:11434/api/generate

{
  "model": "gemma3:1b",
  "prompt": "como são os ambientes?"
}

###

POST http://localhost:11434/api/chat

{
  "model": "gemma3:1b",
  "messages": [{
    "role": "user",
    "content": "o que é a declaração de nova delhi?"
  }]
}


###

POST http://localhost:8000/context
Content-Type: application/json

{
  "query": "o que é a declaração de nova déli?",
  "file": "teste.pdf",
  "score": 1.2
}

